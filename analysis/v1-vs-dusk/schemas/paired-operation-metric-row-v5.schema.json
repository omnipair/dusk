        "sizing_source_sha256": { "$ref": "#/$defs/sha256" }, "observations": { "type": "array", "items": { "$ref": "#/$defs/probe_observation" } },
        "probe_set_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "nullable_spot_probe_set": { "oneOf": [{ "$ref": "#/$defs/spot_probe_set" }, { "type": "null" }] }
  }
}
