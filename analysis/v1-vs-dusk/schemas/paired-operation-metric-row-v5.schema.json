{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omnipair:v1-vs-dusk:schema:paired-operation-metric-row:v5",
  "title": "PairedOperationMetricRowV1",
  "description": "Strict structural snapshot of one exact factual-V1 versus Dusk metric-ledger row. Rust replay and hash checks remain authoritative.",
  "x-snapshot-status": "hand_maintained",
  "x-authoritative-rust-type": "crate::metric_engine::PairedOperationMetricRowV1",
  "x-validation-scope": "full_structural",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "profile_id", "market", "token0", "token1",
    "token0_decimals", "token1_decimals", "operation_id", "order",
    "block_time_unix_seconds", "arm", "hlp_scenario", "synthetic_arbitrage",
    "synthetic_protocol_settlement", "dusk_status", "swap", "spot_probes",
    "borrow", "repay", "safety", "revenue", "capital_after",
    "factual_record_sha256", "dusk_state_sha256"
  ],
  "properties": {
    "schema_version": { "const": 5 },
    "profile_id": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "market": { "$ref": "common-v1.schema.json#/$defs/pubkey" },
    "token0": { "$ref": "common-v1.schema.json#/$defs/pubkey" },
    "token1": { "$ref": "common-v1.schema.json#/$defs/pubkey" },
    "token0_decimals": { "$ref": "common-v1.schema.json#/$defs/u8" },
    "token1_decimals": { "$ref": "common-v1.schema.json#/$defs/u8" },
    "operation_id": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "order": { "$ref": "common-v1.schema.json#/$defs/chain_order" },
    "block_time_unix_seconds": { "$ref": "common-v1.schema.json#/$defs/i64" },
    "arm": { "$ref": "#/$defs/replay_arm" },
    "hlp_scenario": { "$ref": "#/$defs/hlp_scenario" },
    "synthetic_arbitrage": { "type": "boolean" },
    "synthetic_protocol_settlement": { "type": "boolean" },
    "dusk_status": { "$ref": "#/$defs/dusk_status" },
    "swap": { "$ref": "#/$defs/nullable_paired_swap" },
    "spot_probes": { "$ref": "#/$defs/nullable_spot_probe_set" },
    "borrow": { "$ref": "#/$defs/nullable_paired_borrow" },
    "repay": { "$ref": "#/$defs/nullable_paired_repay" },
    "safety": { "$ref": "#/$defs/nullable_safety" },
    "revenue": { "$ref": "#/$defs/paired_revenue" },
    "capital_after": { "$ref": "#/$defs/capital_checkpoint" },
    "factual_record_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "dusk_state_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" }
  },
  "$defs": {
    "token": { "$ref": "common-v1.schema.json#/$defs/token_amount" },
    "signed_token": { "$ref": "common-v1.schema.json#/$defs/signed_token_amount" },
    "sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "replay_arm": { "enum": ["fixed_flow", "intent"] },
    "hlp_scenario": { "enum": ["no_hlp", "maximum_feasible"] },
    "dusk_status": {
      "enum": [
        "executed", "partially_filled", "rejected", "skipped_intent_min_out",
        "no_economic_counterpart", "deferred_external_state"
      ]
    },
    "nullable_token": { "oneOf": [{ "$ref": "#/$defs/token" }, { "type": "null" }] },
    "nullable_signed_token": { "oneOf": [{ "$ref": "#/$defs/signed_token" }, { "type": "null" }] },
    "revenue_side": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lp_swap_earned", "protocol_fee_auction_swap_earned",
        "protocol_buyback_swap_earned", "retained_recenter_inventory",
        "compounded_lp_swap_principal", "lp_public_interest_accrued",
        "protocol_public_interest_accrued", "lp_public_interest_cash_realized",
        "protocol_fee_auction_public_interest_cash_realized",
        "protocol_buyback_public_interest_cash_realized", "hlp_funding_interest_earned",
        "protocol_fee_auction_hlp_funding_interest_earned",
        "protocol_buyback_hlp_funding_interest_earned",
        "flashloan_fee_v1_only", "protocol_claim_realized_v1_only"
