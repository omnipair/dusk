{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omnipair:v1-vs-dusk:schema:terminal-binding:v1",
  "title": "TerminalSnapshotBindingV1 structural snapshot",
  "description": "Independent run/cutoff/program/account/provider expectation for an exact historical terminal account import.",
  "x-snapshot-status": "hand_maintained",
  "x-authoritative-rust-type": "crate::terminal::TerminalSnapshotBindingV1",
  "x-validation-scope": "full_structural",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "cutoff_slot",
    "program_id",
    "requested_accounts",
    "provider"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "$ref": "common-v1.schema.json#/$defs/nonempty_string"
    },
    "cutoff_slot": {
      "$ref": "common-v1.schema.json#/$defs/u64"
    },
    "program_id": {
      "$ref": "common-v1.schema.json#/$defs/pubkey"
    },
    "requested_accounts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common-v1.schema.json#/$defs/pubkey"
      }
    },
    "provider": {
      "$ref": "#/$defs/provider"
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "provider_id",
        "provider_identity_sha256",
        "endpoint_fingerprint_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "provider_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "provider_identity_sha256": {
          "$ref": "common-v1.schema.json#/$defs/sha256"
        },
        "endpoint_fingerprint_sha256": {
          "$ref": "common-v1.schema.json#/$defs/sha256"
        }
      }
    }
  }
}
