{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omnipair:v1-vs-dusk:schema:protocol-interest-schedule:v1",
  "title": "ProtocolInterestShareScheduleV1 structural snapshot",
  "description": "Self-hashed training-only mapping from exact V1 market/config epochs to Dusk protocol shares. Runtime verification remains authoritative for ordering, contiguity, zero-sample fallback, and the domain-separated self-hash.",
  "x-snapshot-status": "hand_maintained",
  "x-authoritative-rust-type": "crate::calibrate::ProtocolInterestShareScheduleV1",
  "x-validation-scope": "full_structural",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "side_weights",
    "epochs",
    "schedule_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source": { "$ref": "#/$defs/training_source" },
    "side_weights": { "$ref": "#/$defs/side_weights" },
    "epochs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/epoch" }
    },
    "schedule_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" }
  },
  "$defs": {
    "epoch_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["market", "config_epoch_id"],
      "properties": {
        "market": { "$ref": "common-v1.schema.json#/$defs/nonempty_string" },
        "config_epoch_id": { "$ref": "common-v1.schema.json#/$defs/sha256" }
      }
    },
    "training_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations_sha256",
        "factual_ledger_sha256",
        "training_start_unix_seconds",
        "training_end_unix_seconds_exclusive"
      ],
      "properties": {
        "operations_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
        "factual_ledger_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
        "training_start_unix_seconds": { "$ref": "common-v1.schema.json#/$defs/i64" },
        "training_end_unix_seconds_exclusive": { "$ref": "common-v1.schema.json#/$defs/i64" }
      }
    },
    "side_weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token0", "token1"],
      "properties": {
        "token0": { "type": "integer", "minimum": 1 },
        "token1": { "type": "integer", "minimum": 1 }
      }
    },
    "epoch": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "training_fit_available": { "const": false } },
            "required": ["training_fit_available"]
          },
          "then": {
            "properties": {
              "training_observation_count": { "const": 0 },
              "token0_borrower_interest": { "const": "0" },
              "token0_nominal_protocol_interest": { "const": "0" },
              "token0_cash_covered_protocol_interest": { "const": "0" },
              "token0_absolute_floor_error": { "const": "0" },
              "token1_borrower_interest": { "const": "0" },
              "token1_nominal_protocol_interest": { "const": "0" },
              "token1_cash_covered_protocol_interest": { "const": "0" },
              "token1_absolute_floor_error": { "const": "0" }
            }
          },
          "else": {
            "properties": {
              "training_observation_count": { "type": "integer", "minimum": 1 }
            }
          }
        }
      ],
      "required": [
        "key",
        "valid_from",
        "valid_to_exclusive",
        "v1_interest_surcharge_bps",
        "dusk_protocol_interest_share_bps",
        "training_fit_available",
        "training_observation_count",
        "training_samples_sha256",
        "token0_borrower_interest",
        "token0_nominal_protocol_interest",
        "token0_cash_covered_protocol_interest",
        "token0_absolute_floor_error",
        "token1_borrower_interest",
        "token1_nominal_protocol_interest",
        "token1_cash_covered_protocol_interest",
        "token1_absolute_floor_error"
      ],
      "properties": {
        "key": { "$ref": "#/$defs/epoch_key" },
        "valid_from": { "$ref": "common-v1.schema.json#/$defs/chain_order" },
        "valid_to_exclusive": {
          "oneOf": [
            { "$ref": "common-v1.schema.json#/$defs/chain_order" },
            { "type": "null" }
          ]
        },
        "v1_interest_surcharge_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "dusk_protocol_interest_share_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "training_fit_available": { "type": "boolean" },
        "training_observation_count": { "$ref": "common-v1.schema.json#/$defs/u64" },
        "training_samples_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
        "token0_borrower_interest": { "$ref": "common-v1.schema.json#/$defs/token_amount" },
        "token0_nominal_protocol_interest": { "$ref": "common-v1.schema.json#/$defs/token_amount" },
        "token0_cash_covered_protocol_interest": { "$ref": "common-v1.schema.json#/$defs/token_amount" },
        "token0_absolute_floor_error": { "$ref": "common-v1.schema.json#/$defs/token_amount" },
        "token1_borrower_interest": { "$ref": "common-v1.schema.json#/$defs/token_amount" },
        "token1_nominal_protocol_interest": { "$ref": "common-v1.schema.json#/$defs/token_amount" },
        "token1_cash_covered_protocol_interest": { "$ref": "common-v1.schema.json#/$defs/token_amount" },
        "token1_absolute_floor_error": { "$ref": "common-v1.schema.json#/$defs/token_amount" }
      }
    }
  }
}
