{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omnipair:v1-vs-dusk:schema:terminal-snapshot:v1",
  "title": "TerminalAccountSnapshotV1 structural snapshot",
  "description": "Exact-cutoff account response envelope. Hash equality, canonical order, exact response slot, and replay equality require TerminalAccountSnapshotV1::validate_for_import and terminal reconciliation.",
  "x-snapshot-status": "hand_maintained",
  "x-authoritative-rust-type": "crate::terminal::TerminalAccountSnapshotV1",
  "x-validation-scope": "full_structural",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding",
    "binding_sha256",
    "response_context_slot",
    "source",
    "accounts",
    "account_set_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "binding": {
      "$ref": "terminal-binding-v1.schema.json"
    },
    "binding_sha256": {
      "$ref": "common-v1.schema.json#/$defs/sha256"
    },
    "response_context_slot": {
      "$ref": "common-v1.schema.json#/$defs/u64"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "accounts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/account"
      }
    },
    "account_set_sha256": {
      "$ref": "common-v1.schema.json#/$defs/sha256"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "read_semantics",
        "provider_request_id",
        "raw_response_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "read_semantics": {
          "enum": [
            "exact_historical_slot",
            "minimum_context_slot",
            "current_state"
          ]
        },
        "provider_request_id": {
          "$ref": "common-v1.schema.json#/$defs/nonempty_string"
        },
        "raw_response_sha256": {
          "$ref": "common-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "address",
        "owner",
        "lamports",
        "executable",
        "rent_epoch",
        "data"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "address": {
          "$ref": "common-v1.schema.json#/$defs/pubkey"
        },
        "owner": {
          "$ref": "common-v1.schema.json#/$defs/pubkey"
        },
        "lamports": {
          "$ref": "common-v1.schema.json#/$defs/token_amount"
        },
        "executable": {
          "type": "boolean"
        },
        "rent_epoch": {
          "$ref": "common-v1.schema.json#/$defs/token_amount"
        },
        "data": {
          "oneOf": [
            {
              "$ref": "#/$defs/base64_data"
            },
            {
              "$ref": "#/$defs/byte_data"
            }
          ]
        }
      }
    },
    "base64_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "data_base64",
        "byte_length",
        "data_sha256"
      ],
      "properties": {
        "encoding": {
          "const": "base64"
        },
        "data_base64": {
          "type": "string"
        },
        "byte_length": {
          "$ref": "common-v1.schema.json#/$defs/u64"
        },
        "data_sha256": {
          "$ref": "common-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "byte_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "bytes",
        "byte_length",
        "data_sha256"
      ],
      "properties": {
        "encoding": {
          "const": "bytes"
        },
        "bytes": {
          "type": "array",
          "items": {
            "$ref": "common-v1.schema.json#/$defs/u8"
          }
        },
        "byte_length": {
          "$ref": "common-v1.schema.json#/$defs/u64"
        },
        "data_sha256": {
          "$ref": "common-v1.schema.json#/$defs/sha256"
        }
      }
    }
  }
}
