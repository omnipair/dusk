{
  "name": "omnipair-dusk",
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "cargo test -p dusk && cargo test -p leverage_delegate && yarn test-litesvm",
    "typecheck": "tsc --noEmit",
    "build:litesvm": "anchor build -p dusk && anchor build -p leverage_delegate && cargo build-sbf --manifest-path tests/fixtures/referral_transfer_hook/Cargo.toml --sbf-out-dir target/deploy && cargo build-sbf --manifest-path tests/fixtures/token_metadata_fixture/Cargo.toml --sbf-out-dir target/deploy",
    "test-litesvm": "yarn build:litesvm && yarn test-litesvm:no-build",
    "test-litesvm:no-build": "mocha --require ts-node/register --extensions ts tests/v2-final-smoke.test.ts",
    "test-litesvm:release": "yarn build:litesvm && DUSK_REQUIRE_COMPLETE_CU_BASELINE=1 yarn test-litesvm:no-build",
    "check:hygiene": "node scripts/check_repo_hygiene.js",
    "check:code-shape": "node scripts/check_one_use_helpers.js",
    "check:clippy": "cargo clippy -p dusk --lib -- -A unexpected-cfgs -A clippy::too_many_arguments -D warnings && cargo clippy -p leverage_delegate --lib -- -A unexpected-cfgs -A clippy::too_many_arguments -D warnings",
    "check:dusk-sdk": "npm run check-idl-current --prefix packages/dusk-sdk && npm run typecheck --prefix packages/dusk-sdk",
    "check:program-interface": "npm run check:dusk-sdk",
    "test-coverage": "yarn test-litesvm",
    "coverage": "cargo tarpaulin -p dusk --out Html --output-dir coverage --exclude-files tests",
    "coverage-report": "open coverage/index.html",
    "deploy-tokens": "ts-node --esm scripts/utils/deploy_tokens.ts",
    "address-vanity": "ts-node --esm scripts/utils/address_vanity.ts",
    "v2:create-mock-tokens": "ts-node --esm scripts/v2/create_mock_tokens.ts",
    "v2:mint-mock-tokens": "ts-node --esm scripts/v2/mint_mock_tokens.ts",
    "v2:bootstrap-market": "ts-node --esm scripts/v2/bootstrap_market.ts",
    "v2:smoke-devnet": "ts-node --esm scripts/v2/smoke_v2_devnet.ts",
    "v2:build-devnet": "anchor build -p dusk -- --arch v3",
    "v2:deploy-devnet": "solana program deploy target/deploy/dusk.so --program-id ${DUSK_PROGRAM_KEYPAIR:-$HOME/.config/omnipair/dusk-devnet/dusk-program-keypair.json} --url devnet",
    "v2-fork:surfpool": "node dist/v2-fork-lab/surfpool_controller.js",
    "v2-fork:surfpool:cli": "bash scripts/v2-fork-lab/start_surfpool.sh",
    "v2-fork:rpc-proxy": "TS_NODE_PROJECT=scripts/v2-fork-lab/tsconfig.json node --loader ts-node/esm scripts/v2-fork-lab/rpc_proxy.ts",
    "v2-fork:api": "TS_NODE_PROJECT=scripts/v2-fork-lab/tsconfig.json node --loader ts-node/esm scripts/v2-fork-lab/api.ts",
    "v2-fork:sync-idls": "node scripts/v2-fork-lab/sync_idls.mjs",
    "check:v2-fork-idls": "node scripts/v2-fork-lab/sync_idls.mjs --check",
    "build:v2-fork-api": "tsc --target es2022 --module nodenext --moduleResolution nodenext --esModuleInterop --resolveJsonModule --skipLibCheck --types node --rootDir scripts --outDir dist scripts/v2-fork-lab/api.ts scripts/v2-fork-lab/api_core.ts",
    "build:v2-fork-rpc-controller": "tsc --target es2022 --module nodenext --moduleResolution nodenext --esModuleInterop --resolveJsonModule --skipLibCheck --types node --rootDir scripts --outDir dist scripts/v2-fork-lab/surfpool_controller.ts scripts/v2-fork-lab/surfpool_relay_worker.ts scripts/v2-fork-lab/api_core.ts && cp scripts/v2-fork-lab/seed_fork_generation.mjs dist/v2-fork-lab/seed_fork_generation.mjs",
    "test-surfpool-v2": "ts-node --esm scripts/v2-fork-lab/surfpool_v2_e2e.ts",
    "test:v2-fork-pure": "TS_NODE_PROJECT=scripts/v2-fork-lab/tsconfig.json mocha --no-config --node-option loader=ts-node/esm --extension ts scripts/v2-fork-lab/api_core.two_markets.test.ts",
    "test:v2-fork-controller": "TS_NODE_PROJECT=scripts/v2-fork-lab/tsconfig.json mocha --no-config --node-option loader=ts-node/esm --extension ts scripts/v2-fork-lab/surfpool_controller.test.ts",
    "test:v2-fork-api": "TS_NODE_PROJECT=scripts/v2-fork-lab/tsconfig.json mocha --no-config --node-option loader=ts-node/esm --extension ts scripts/v2-fork-lab/api.test.ts",
    "test:v2-fork-rpc-proxy": "TS_NODE_PROJECT=scripts/v2-fork-lab/tsconfig.json mocha --no-config --node-option loader=ts-node/esm --extension ts scripts/v2-fork-lab/rpc_proxy.test.ts",
    "surfpool-v2-e2e": "anchor build -p dusk -- --features \"development\" && ts-node --esm scripts/v2-fork-lab/surfpool_v2_e2e_runner.ts",
    "surfpool-sdk-e2e": "TS_NODE_PROJECT=scripts/v2-fork-lab/tsconfig.json node --loader ts-node/esm scripts/v2-fork-lab/surfpool_sdk_e2e.ts",
    "test-protocol-client": "TS_NODE_PROJECT=scripts/protocol-tests/tsconfig.json node --loader ts-node/esm scripts/protocol-tests/run.ts",
    "test:protocol-runner": "TS_NODE_PROJECT=scripts/protocol-tests/tsconfig.json mocha --no-config --node-option loader=ts-node/esm --extension ts scripts/protocol-tests/run_fresh.test.ts scripts/protocol-tests/harness.timeout.test.ts",
    "test-protocol-client:fresh": "TS_NODE_PROJECT=scripts/protocol-tests/tsconfig.json node --loader ts-node/esm scripts/protocol-tests/run_fresh.ts",
    "typecheck:protocol-client": "tsc -p scripts/protocol-tests/tsconfig.json"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@metaplex-foundation/mpl-token-metadata": "2.13.0",
    "@metaplex-foundation/umi": "0.8.2",
    "@solana/spl-token": "^0.4.0",
    "@solana/surfpool": "1.5.0",
    "@solana/web3.js": "^1.95.0",
    "dotenv": "^16.5.0",
    "ws": "8.21.1"
  },
  "optionalDependencies": {
    "@solana/surfpool-darwin-arm64": "1.5.0",
    "@solana/surfpool-darwin-x64": "1.5.0",
    "@solana/surfpool-linux-x64-gnu": "1.5.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/ws": "8.18.1",
    "chai": "^4.3.0",
    "litesvm": "0.8.0",
    "mocha": "^10.0.0",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
