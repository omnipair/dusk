FROM node:22.23.2-bookworm-slim

WORKDIR /app

ENV DUSK_REQUIRE_EXPLICIT_FORK_SIGNER=true \
    DUSK_REQUIRE_EXTERNAL_FORK_MARKER=true \
    DUSK_REQUIRE_PREBOOTSTRAPPED_MARKETS=true \
    DUSK_REQUIRE_PUBLIC_RPC_URL=true \
    FORK_REQUIRE_ADMIN_TOKEN=true

COPY package.json package-lock.json tsconfig.json ./
RUN npm ci --include=dev

COPY scripts/v2-fork-lab ./scripts/v2-fork-lab
COPY scripts/protocol-tests ./scripts/protocol-tests
COPY packages/dusk-sdk/src/idl_v2.json ./packages/dusk-sdk/src/idl_v2.json

RUN npm run build:v2-fork-api && \
    test -f dist/v2-fork-lab/api.js && \
    test -f dist/v2-fork-lab/api_core.js && \
    test -f dist/protocol-tests/catalog.js

EXPOSE 8080

CMD ["node", "dist/v2-fork-lab/api.js"]
