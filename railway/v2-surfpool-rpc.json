{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.v2-fork-rpc",
    "watchPatterns": [
      ".dockerignore",
      "Dockerfile.v2-fork-rpc",
      "Anchor.toml",
      "Cargo.toml",
      "Cargo.lock",
      "package.json",
      "package-lock.json",
      "railway/v2-surfpool-rpc.json",
      "programs/dusk/**",
      "programs/leverage_delegate/**",
      "packages/dusk-sdk/src/idl_v2.json",
      "scripts/protocol-tests/catalog.ts",
      "scripts/protocol-tests/types.ts",
      "scripts/v2-fork-lab/api_core.ts",
      "scripts/v2-fork-lab/bootstrap_fork.ts",
      "scripts/v2-fork-lab/idl/leverage_delegate.json",
      "scripts/v2-fork-lab/materialize_fork_signer.mjs",
      "scripts/v2-fork-lab/seed_fork_generation.mjs",
      "scripts/v2-fork-lab/start_surfpool.sh",
      "scripts/v2-fork-lab/surfpool_controller.ts",
      "scripts/v2-fork-lab/surfpool_relay_worker.ts",
      "scripts/v2-fork-lab/surfpool_controller.test.ts",
      "scripts/v2-fork-lab/README.md"
    ]
  },
  "deploy": {
    "startCommand": "node dist/v2-fork-lab/surfpool_controller.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 600,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
