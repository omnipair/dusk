FROM rust:1-trixie

ARG DEBIAN_FRONTEND=noninteractive
ARG TARGETARCH
ARG NODE_VERSION=22.23.2
ARG SOLANA_CLI=2.3.11
ARG ANCHOR_CLI=0.31.1

ENV HOME=/root
ENV PATH="/opt/node/bin:/root/.cargo/bin:/root/.local/bin:/root/.avm/bin:/root/.local/share/solana/install/active_release/bin:${PATH}"
ENV FORK_LAB_BUILD=false
ENV SURFPOOL_HOST=::
ENV SURFPOOL_HEALTH_HOST=::

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    curl \
    git \
    jq \
    libssl-dev \
    libudev-dev \
    pkg-config \
    python3 \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN case "${TARGETARCH:-amd64}" in \
        amd64) node_arch="x64" ;; \
        arm64) node_arch="arm64" ;; \
        *) echo "Unsupported Docker target architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && mkdir -p /opt/node \
    && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" \
        | tar -xJ -C /opt/node --strip-components=1 \
    && npm install -g yarn@1.22.22 \
    && node --version \
    && npm --version

RUN sh -c "$(curl -sSfL https://release.anza.xyz/v${SOLANA_CLI}/install)"

RUN cargo install --git https://github.com/coral-xyz/anchor avm --locked --force \
    && avm install "${ANCHOR_CLI}" \
    && avm use "${ANCHOR_CLI}"

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --include=dev

COPY . .

RUN anchor build -p dusk -- --features "development"
RUN anchor build -p leverage_delegate -- --features "development"
RUN npm run build:v2-fork-rpc-controller \
    && test -f dist/v2-fork-lab/surfpool_controller.js \
    && test -f dist/v2-fork-lab/surfpool_relay_worker.js \
    && test -f dist/v2-fork-lab/api_core.js \
    && test -f dist/v2-fork-lab/seed_fork_generation.mjs \
    && test -f dist/protocol-tests/catalog.js

EXPOSE 8899 8900

CMD ["node", "dist/v2-fork-lab/surfpool_controller.js"]
