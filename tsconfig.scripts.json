{
  "compilerOptions": {
    "esModuleInterop": true,
    "lib": ["es2022", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "noEmit": true
  },
  "include": ["scripts/devnet/**/*.ts"]
}
