# Environment Variables for Omnipair V2 (Dusk)
# Copy this file to .env and fill in the values

# =============================================================================
# BUILD CONFIGURATION
# =============================================================================
LIBRARY_NAME=dusk
PROGRAM_LIB_NAME=dusk
DUSK_PROGRAM_ID=
REPO_PATH=
COMMIT_HASH=
MOUNT_PATH=

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================
DEVNET_NETWORK_URL=https://api.devnet.solana.com
MAINNET_NETWORK_URL=https://api.mainnet-beta.solana.com

# =============================================================================
# ANCHOR CONFIGURATION
# =============================================================================
# Devnet (default)
ANCHOR_CLUSTER=devnet
ANCHOR_WALLET=~/.config/solana/id.json
ANCHOR_PROVIDER_URL=https://api.devnet.solana.com

# For custom RPC (e.g., Helius, QuickNode):
# ANCHOR_PROVIDER_URL=https://your-rpc-provider.com/?api-key=YOUR_API_KEY

# Mainnet (uncomment for production)
# ANCHOR_CLUSTER=mainnet
# ANCHOR_WALLET=mainnet-keypair.json
# ANCHOR_PROVIDER_URL=https://api.mainnet-beta.solana.com

# =============================================================================
# TOKEN CONFIGURATION (for scripts)
# =============================================================================
TOKEN0_MINT=
TOKEN1_MINT=
DEPLOYER_TOKEN0_ACCOUNT=
DEPLOYER_TOKEN1_ACCOUNT=

# =============================================================================
# SCRIPT-SPECIFIC VARIABLES
# =============================================================================
# OWNER_ADDRESS=
# MINT_ADDRESS=
# BASE_ADDRESS=
# USER_ADDRESS=

# Explicit AMM controls (NAD fixed point: 1.0 = 1000000000).
# A zero concentrated-liquidity share selects exact CPMM behavior. Positive
# shares allocate liquidity to the log-symmetric band set by range width while
# preserving a nonzero full-range CPMM tail.
AMM_RANGE_WIDTH_NAD=0
AMM_CONCENTRATED_LIQUIDITY_SHARE_NAD=0

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Program IDs are source-declared, not selected by Cargo features:
# - development: selects the development emergency authority
# - production: prospectively enforces LP-mint vanity suffixes
#
# Usage:
# anchor build -- --features "development"
# anchor build -- --features "production"
