# Environment Variables for Omnipair V2 (Dusk)
# Copy this file to .env and fill in the values

# =============================================================================
# BUILD CONFIGURATION
# =============================================================================
LIBRARY_NAME=dusk
PROGRAM_LIB_NAME=dusk
DUSK_PROGRAM_ID=
REPO_PATH=
COMMIT_HASH=
MOUNT_PATH=

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================
DEVNET_NETWORK_URL=https://api.devnet.solana.com
MAINNET_NETWORK_URL=https://api.mainnet-beta.solana.com

# =============================================================================
# ANCHOR CONFIGURATION
# =============================================================================
# Devnet (default)
ANCHOR_CLUSTER=devnet
ANCHOR_WALLET=~/.config/solana/id.json
ANCHOR_PROVIDER_URL=https://api.devnet.solana.com

# For custom RPC (e.g., Helius, QuickNode):
# ANCHOR_PROVIDER_URL=https://your-rpc-provider.com/?api-key=YOUR_API_KEY

# Mainnet (uncomment for production)
# ANCHOR_CLUSTER=mainnet
# ANCHOR_WALLET=mainnet-keypair.json
# ANCHOR_PROVIDER_URL=https://api.mainnet-beta.solana.com

# =============================================================================
# TOKEN CONFIGURATION (for scripts)
# =============================================================================
TOKEN0_MINT=
TOKEN1_MINT=
DEPLOYER_TOKEN0_ACCOUNT=
DEPLOYER_TOKEN1_ACCOUNT=

# =============================================================================
# SCRIPT-SPECIFIC VARIABLES
# =============================================================================
# OWNER_ADDRESS=
# MINT_ADDRESS=
# BASE_ADDRESS=
# USER_ADDRESS=

# Explicit AMM controls (NAD fixed point: 1.0 = 1000000000).
# One-times peak amplification with zero widths selects exact CPMM behavior.
# Larger peaks use a full-depth core plus one half-depth shoulder while always
# preserving a nonzero full-range CPMM tail.
AMM_PEAK_AMPLIFICATION_NAD=1000000000
AMM_CORE_HALF_WIDTH_BPS=0
AMM_FADE_WIDTH_BPS=0

# Optional launch/graduation controls. Swap fee mode is 0=input asset,
# 1=Base only, 2=Quote only; Base-token launches normally use 2. A nonzero
# bootstrap price must exactly match the first fully backed Base/Quote seed.
MARKET_START_TIME=0
BOOTSTRAP_PRICE_NAD=0
LAUNCH_FEE_PROGRESS_OFFSET=0
AMM_SWAP_FEE_COLLECT_MODE=0
# 0 disables native compounding; 10000 compounds all LP-owned swap fees.
AMM_COMPOUNDING_FEE_BPS=0
AMM_LAUNCH_FEE_START_BPS=0
AMM_LAUNCH_FEE_DURATION_SECONDS=0
AMM_LAUNCH_FEE_DECAY_MODE=0
AMM_LAUNCH_MARKET_PRICE_STEP_BPS=0
AMM_LAUNCH_MARKET_NUMBER_OF_PERIODS=0
AMM_LAUNCH_MARKET_REDUCTION_FACTOR_BPS=0
AMM_LAUNCH_RATE_LIMIT_ASSET=0
AMM_LAUNCH_RATE_LIMIT_REFERENCE_NAD=0
AMM_LAUNCH_RATE_LIMIT_INCREMENT_BPS=0
AMM_LAUNCH_RATE_LIMIT_MAX_FEE_BPS=0
AMM_LAUNCH_RATE_LIMIT_DURATION_SECONDS=0

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Program IDs are source-declared, not selected by Cargo features:
# - development: selects the development emergency authority
# - production: prospectively enforces LP-mint vanity suffixes
#
# Usage:
# anchor build -- --features "development"
# anchor build -- --features "production"
